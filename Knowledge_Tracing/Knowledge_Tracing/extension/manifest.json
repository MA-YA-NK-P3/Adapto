{
  "manifest_version": 3,
  "name": "Knowledge Tracer (research prototype)",
  "version": "0.1.0",
  "description": "Collects LeetCode practice observations and shows the next recommended action from a Knowledge Tracer backend.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://leetcode.com/*", "http://localhost:8080/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["src/lib/extract.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Knowledge Tracer", "default_popup": "popup/popup.html" },
  "options_page": "options/options.html"
}
